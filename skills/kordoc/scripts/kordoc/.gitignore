node_modules/
# dist/는 의도적으로 커밋한다 — 설치 환경(사회복지 현장 Windows 등)에
# 빌드 툴체인을 요구하지 않기 위해 산출물을 동봉한다.
# 소스를 고쳤다면 `npm run build` 후 dist/도 함께 커밋할 것.
*.tsbuildinfo
.DS_Store
demo/node_modules/
.tools/
.vscode/

# 실제 문서 fixture — 개인 문서이므로 저장소에 포함하지 않음
tests/fixtures/sample.*

# dummy fixture는 커밋 (CI용 — 프로그래밍 생성 문서)
!tests/fixtures/dummy.*

# 입력
input/

# 결과물
output/